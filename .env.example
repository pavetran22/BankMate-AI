# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model used by the agent
BANKMATE_MODEL=gemini-2.5-flash

# Embedding model for hybrid retrieval (set USE_EMBEDDINGS=0 to use BM25 only)
BANKMATE_EMBED_MODEL=gemini-embedding-001
USE_EMBEDDINGS=1

# 1 = run without an API key using a scripted offline model (demo/tests only)
OFFLINE_MODE=0
